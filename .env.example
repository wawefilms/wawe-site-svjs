# Required
# Payload CMS origin (local dev default http://localhost:3000)
PAYLOAD_API_URL=http://localhost:3000
PUBLIC_SITE_URL=https://wawefilms.com
# Public R2 media origin — same-origin proxy for the showreel atlas checks
# against this (videos are proxied so canvas frames don't taint WebGL)
R2_PUBLIC_URL=https://media.wawefilms.com
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=
RESEND_API_KEY=
RESEND_EMAIL_SENDER=
RESEND_EMAIL_RECEIVER=
